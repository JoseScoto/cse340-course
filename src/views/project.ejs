<%- include('partials/header') %>
    <main class="container">
        <h1>
            <%= project.title %>
        </h1>
        <p>
            <%= project.description %>
        </p>
        <p><strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric' })
                %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>
        <p><strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>
        <p><strong>Categories:</strong></p>
        <ul class="category-list">
            <% categories.forEach(category=> { %>
                <li class="category-tag">
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }); %>
        </ul>
        <% if (user && user.role_name === 'admin') { %>
            <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
            <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
        <% } %>

        <% if (user) { %>
            <section aria-labelledby="volunteer-heading">
                <h2 id="volunteer-heading">Volunteer</h2>
        
                <% if (isVolunteering) { %>
                    <p>You are volunteering for this project.</p>
        
                    <form class="volunteer-form" action="/project/<%= project.project_id %>/remove-volunteer" method="post">
                        <input type="hidden" name="returnTo" value="project">
        
                        <button type="submit">
                            Remove my volunteer signup
                        </button>
                    </form>
                    <% } else { %>
                        <form class="volunteer-form" action="/project/<%= project.project_id %>/volunteer" method="post">
                            <button type="submit">
                                Volunteer for this project
                            </button>
                        </form>
                        <% } %>
        
                            <p><a href="/dashboard">View my volunteer projects</a></p>
            </section>
            <% } %>

    </main>
    

    <%- include('partials/footer') %>