<%- include('partials/header') %>
    <main class="container">
        <h1>
            <%= title %>
        </h1>
        <h2>Categories</h2>
        <ul class="category-list">
            <% categories.forEach(category=> { %>
                <li class="category-tag">
                    <%= category.name %>
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>