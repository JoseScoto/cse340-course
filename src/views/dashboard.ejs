<%- include('partials/header') %>

    <main class="container">
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>

        <% if (user && user.role_name === 'admin') { %>
            <h2>User Management</h2>
            <p><a href="/users">View Registered Users</a></p>
        <% } %>
 
    </main>

    <%- include('partials/footer') %>