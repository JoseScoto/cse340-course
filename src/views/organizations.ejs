<%- include('partials/header') %>
    <main class="container">
        <h1>
            <%= title %>
        </h1>

        <p>Here are a few of our partner organizations:</p>
        <ul class="org-list">

            <% organizations.forEach(organization=> { %>
                <li class="org-card"><img src="/images/<%= organization.logo_filename %>"
                        alt="<%= organization.name %> logo"><strong>
                        <%= organization.name %>
                    </strong>: <%= organization.contact_email %>
                        <p>
                            <%= organization.description %>
                        </p>
                </li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>